{
  "name": "@spautz/playground-public",
  "private": true,
  "description": "Various demos and proof-of-concept attempts",
  "license": "MIT",
  "homepage": "https://github.com/spautz/playground-public#readme",
  "bugs": "https://github.com/spautz/playground-public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spautz/playground-public.git"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com/"
  },
  "engines": {
    "node": "^26",
    "pnpm": ">=11.13.0 <12"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a",
  "type": "module",
  "scripts": {
    "____ HOOKS _________________________________________________________": "",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "husky:precommit": "lint-staged",
    "husky:prepush": "pnpm run format:verify",
    "____ INDIVIDUAL COMMANDS ___________________________________________": "",
    "dev": "serve -s ./public",
    "start": "serve -s ./public",
    "deploy:github": "gh-pages -d ./public",
    "format": "prettier --write .",
    "format:verify": "prettier --list-different ."
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "serve": "14.2.6"
  },
  "lint-staged": {
    "*.{cjs,cts,css,html,js,jsx,json,jsonc,less,md,mdx,mjs,mts,scss,ts,tsx,yaml}": [
      "prettier --write"
    ]
  }
}
